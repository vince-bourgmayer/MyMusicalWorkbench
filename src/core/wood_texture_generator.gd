extends RefCounted
class_name WoodTextureGenerator

const WALNUT_COLORS = { VINTAGE_WALNUT = "6E3B3B", NATURAL_WALNUT = "7F5D47", DEEP_WALNUT="543D32", WARM_WALNUT="7B5141"}
const ASH_COLORS = {BASIC_ASH = "ccbd9eff"}

static func generate_yellowPine_plank_texture(
		width: int,
		height: int,
		rand_seed: int = 1
	) -> ImageTexture:

	var image := Image.create(width, height, false, Image.FORMAT_RGBA8)

	# 1) Variation douce globale (grandes zones)
	var cloud_noise := FastNoiseLite.new()
	cloud_noise.seed = rand_seed
	cloud_noise.noise_type = FastNoiseLite.TYPE_SIMPLEX
	cloud_noise.frequency = 0.004

	# 2) Fibres (verticales): bruit 1D sur X
	var fiber_noise := FastNoiseLite.new()
	fiber_noise.seed = rand_seed + 999
	fiber_noise.noise_type = FastNoiseLite.TYPE_SIMPLEX
	fiber_noise.frequency = 0.08

	# 3) Bruit lent pour casser la symétrie des "V"
	var flame_wobble_noise := FastNoiseLite.new()
	flame_wobble_noise.seed = rand_seed + 4242
	flame_wobble_noise.noise_type = FastNoiseLite.TYPE_SIMPLEX
	flame_wobble_noise.frequency = 0.003

	# Palette / rendu de base (frêne clair)
	var base_color := Color("7F5D47")
	var cloud_strength := 0.14
	var fiber_strength := 0.36

	# --- Étape 2 : réglages des "V / flammes"
	var rng = RandomNumberGenerator.new()
	var flame_center_x := rng.randf_range(0.25, 0.78)
	
	#var flame_center_x := 0.35       # 0..1 : centre du chevron
	var flame_strength := -1.22      # intensité des V (0 = off)
	#var flame_depth = rng.randf_range(1.0, 5.25)
	var flame_depth := -0.15 #1.35 de base        # ouverture vers le bas (plus haut = plus concentré)
	var flame_wobble_strength := 0.25 # irrégularité (0..1)

	for y in range(height):

		var fy := float(y) / float(height)

		# remap: fy ne va jamais dans [0..top_margin], ça évite l'explosion sans casser la signature
		var top_margin := 0.65
		var fy_remap := top_margin + (1.0 - top_margin) * fy

		var open_factor := pow(fy_remap, flame_depth)

		for x in range(width):
			var fx := float(x) / float(width)

			# 1) Nuage de teinte
			var cloud := cloud_noise.get_noise_2d(x, y) # [-1..1]
			cloud = (cloud + 1.0) * 0.5                 # [0..1]

			# --- Étape 2 : offset en V
			# distance au centre -> forme en V (0 au centre, 1 sur les bords)
			var distance_to_center = abs(fx - flame_center_x) * 2.0 # 0..1
			var v_shape := pow(distance_to_center, 1.6)              # courbe jolie

			# bruit lent pour éviter un V trop "parfait"
			var wobble := flame_wobble_noise.get_noise_2d(x, y)      # [-1..1]
			wobble *= flame_wobble_strength

			# offset final (en "coordonnées x" normalisées)
			var flame_offset := (v_shape * open_factor + wobble * 0.15) * flame_strength

			# 2) Fibres: on lit le bruit à un X "déformé"
			# IMPORTANT: on reste en vertical => on ne dépend PAS de y ici, juste d'un x déplacé.
			var sample_x := float(x) + flame_offset * float(width)

			var fiber := fiber_noise.get_noise_1d(sample_x) # [-1..1]
			fiber = (fiber + 1.0) * 0.5                     # [0..1]

			# Couleur finale
			var c := base_color
			c = c.darkened((cloud - 0.5) * cloud_strength)
			c = c.darkened(fiber * fiber_strength)

			image.set_pixel(x, y, c)

	return ImageTexture.create_from_image(image)
	
	
	
